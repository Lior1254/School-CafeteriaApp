<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Selected state: Orange/Warm background -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/category_selected" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <!-- Normal state: Light gray/White border -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <stroke android:width="1.5dp" android:color="@color/category_unselected_border" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</selector>
