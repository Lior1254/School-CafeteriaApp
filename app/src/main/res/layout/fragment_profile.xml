<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/profilebkg"
    android:fillViewport="true"
    android:scrollbars="none"
    tools:context=".Fragments.ProfileFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="16dp"> <!-- מרווח בתחתית הגלילה -->

        <!-- ===================================== -->
        <!--      חלק עליון (נגלל)               -->
        <!-- ===================================== -->
        <ImageView
            android:id="@+id/profileImg"
            android:layout_width="84dp"
            android:layout_height="77dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/titleName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Name"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/profileImg"
            app:layout_constraintStart_toStartOf="@id/profileImg"
            app:layout_constraintEnd_toEndOf="@id/profileImg" />

        <TextView
            android:id="@+id/titleUsername"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="username"
            android:textColor="@color/white"
            android:textSize="18sp"
            app:layout_constraintTop_toBottomOf="@id/titleName"
            app:layout_constraintEnd_toStartOf="@+id/verifiedIcon"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageView
            android:id="@+id/verifiedIcon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="@id/titleUsername"
            app:layout_constraintStart_toEndOf="@id/titleUsername"
            app:layout_constraintTop_toTopOf="@id/titleUsername"
            app:layout_constraintEnd_toEndOf="parent"
            app:tint="@color/white" />


        <!-- ===================================== -->
        <!--      כרטיס 1: ניהול חשבון           -->
        <!-- ===================================== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/accountCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            app:cardBackgroundColor="@color/ice_blue"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp"
            app:cardUseCompatPadding="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/titleUsername">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <!-- שורה: ערוך פרופיל -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/rowEditProfile"
                    style="@style/ProfileRowStyle">

                    <FrameLayout
                        android:id="@+id/iconBgEditProfile"
                        style="@style/ProfileIconContainerStyle"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView style="@style/ProfileIconStyle" />
                    </FrameLayout>

                    <TextView
                        style="@style/ProfileTextStyle"
                        android:layout_marginEnd="8dp"
                        android:text="ערוך פרופיל"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/arrowEditProfile"
                        app:layout_constraintStart_toEndOf="@id/iconBgEditProfile"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/arrowEditProfile"
                        style="@style/ProfileArrowStyle"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <View style="@style/ProfileSeparatorStyle" />

                <!-- שורה: היסטוריית הזמנות -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/rowOrderHistory"
                    style="@style/ProfileRowStyle">

                    <FrameLayout
                        android:id="@+id/iconBgOrderHistory"
                        style="@style/ProfileIconContainerStyle"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView style="@style/ProfileIconStyle" />
                    </FrameLayout>

                    <TextView
                        style="@style/ProfileTextStyle"
                        android:layout_marginEnd="8dp"
                        android:text="ההזמנות שלי"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/arrowOrderHistory"
                        app:layout_constraintStart_toEndOf="@id/iconBgOrderHistory"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/arrowOrderHistory"
                        style="@style/ProfileArrowStyle"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <View style="@style/ProfileSeparatorStyle" />

                <!-- שורה: אמצעי תשלום -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/rowPaymentMethods"
                    style="@style/ProfileRowStyle">

                    <FrameLayout
                        android:id="@+id/iconBgPayment"
                        style="@style/ProfileIconContainerStyle"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView style="@style/ProfileIconStyle" />
                    </FrameLayout>

                    <TextView
                        style="@style/ProfileTextStyle"
                        android:layout_marginEnd="8dp"
                        android:text="אמצעי תשלום"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/arrowPayment"
                        app:layout_constraintStart_toEndOf="@id/iconBgPayment"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/arrowPayment"
                        style="@style/ProfileArrowStyle"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===================================== -->
        <!--      כרטיס 2: הגדרות ומידע          -->
        <!-- ===================================== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/settingsCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:cardBackgroundColor="@color/ice_blue"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp"
            app:cardUseCompatPadding="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/accountCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <!-- שורה: מצב לילה -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/rowNightMode"
                    style="@style/ProfileRowStyle">

                    <FrameLayout
                        android:id="@+id/iconBgNight"
                        style="@style/ProfileIconContainerStyle"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <ImageView
                            android:src="@drawable/ic_night_mode_icon"
                            style="@style/ProfileIconStyle" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/titleNight"
                        android:text="מצב לילה"
                        style="@style/ProfileTextStyle"
                        android:layout_marginEnd="8dp"
                        app:layout_constraintStart_toEndOf="@id/iconBgNight"
                        app:layout_constraintEnd_toStartOf="@+id/switchNight"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchNight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:paddingEnd="12dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <View style="@style/ProfileSeparatorStyle" />

                <!-- שורה: העדפות תזונה -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/rowDiet"
                    style="@style/ProfileRowStyle">

                    <FrameLayout
                        android:id="@+id/iconBgDiet"
                        style="@style/ProfileIconContainerStyle"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <ImageView style="@style/ProfileIconStyle" />
                    </FrameLayout>

                    <TextView
                        android:text="העדפות תזונה"
                        style="@style/ProfileTextStyle"
                        android:layout_marginEnd="8dp"
                        app:layout_constraintStart_toEndOf="@id/iconBgDiet"
                        app:layout_constraintEnd_toStartOf="@+id/arrowDiet"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <ImageView
                        android:id="@+id/arrowDiet"
                        style="@style/ProfileArrowStyle"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <View style="@style/ProfileSeparatorStyle" />

                <!-- שורה: שפה -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/rowLanguage"
                    style="@style/ProfileRowStyle">

                    <FrameLayout
                        android:id="@+id/iconBgLang"
                        style="@style/ProfileIconContainerStyle"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <ImageView
                            android:src="@drawable/ic_language_icon"
                            style="@style/ProfileIconStyle" />
                    </FrameLayout>

                    <TextView
                        android:text="שפה"
                        style="@style/ProfileTextStyle"
                        android:layout_marginEnd="8dp"
                        app:layout_constraintStart_toEndOf="@id/iconBgLang"
                        app:layout_constraintEnd_toStartOf="@+id/arrowLang"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <ImageView
                        android:id="@+id/arrowLang"
                        style="@style/ProfileArrowStyle"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===================================== -->
        <!--      כרטיס 3: יציאה מהמערכת         -->
        <!-- ===================================== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/logoutCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:cardBackgroundColor="@color/logout_red_foreground"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp"
            app:cardUseCompatPadding="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/settingsCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <!-- שורה: התנתק -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/rowLogout"
                    style="@style/ProfileRowStyle">

                    <FrameLayout
                        android:id="@+id/iconBgLogout"
                        style="@style/ProfileIconContainerStyle"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <ImageView
                            style="@style/ProfileIconStyle"
                            app:tint="@color/white" />
                        app:tint="@color/white" />

                    </FrameLayout>

                    <TextView
                        style="@style/ProfileTextStyle"
                        android:layout_marginEnd="16dp"
                        android:text="התנתק"
                        android:textColor="@color/white"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/iconBgLogout"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>