<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    android:layoutDirection="rtl"
    app:cardCornerRadius="24dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:paddingBottom="16dp">

        <!-- Header: Order Number & Status Chip -->
        <TextView
            android:id="@+id/tvOrderNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:textColor="#212121"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="הזמנה #1024" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/statusChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            app:cardBackgroundColor="#FFF3E0"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="@id/tvOrderNumber"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvOrderNumber">

            <TextView
                android:id="@+id/tvOrderStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:textColor="#F57C00"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="בהכנה" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Stepper Section -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/stepperLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:paddingHorizontal="20dp"
            app:layout_constraintTop_toBottomOf="@id/tvOrderNumber">

            <!-- Background Gray Line -->
            <View
                android:id="@+id/view_line_back"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_marginTop="20dp"
                android:background="#E0E0E0"
                app:layout_constraintEnd_toEndOf="@id/step4_circle"
                app:layout_constraintStart_toStartOf="@id/step1_circle"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Active Line -->
            <View
                android:id="@+id/view_line_active"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:background="@color/status_ready_green"
                app:layout_constraintBottom_toBottomOf="@id/view_line_back"
                app:layout_constraintEnd_toStartOf="@id/step2_circle"
                app:layout_constraintStart_toStartOf="@id/step1_circle"
                app:layout_constraintTop_toTopOf="@id/view_line_back" />

            <!-- Steps -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/step1_circle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:cardBackgroundColor="@color/status_ready_green"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:layout_constraintHorizontal_chainStyle="spread_inside"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/checkbox_on_background"
                    app:tint="@color/white" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tv_step1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="התקבלה"
                android:textColor="#212121"
                android:textSize="10sp"
                app:layout_constraintEnd_toEndOf="@id/step1_circle"
                app:layout_constraintStart_toStartOf="@id/step1_circle"
                app:layout_constraintTop_toBottomOf="@id/step1_circle" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/step2_circle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:cardBackgroundColor="#FF6B35"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toStartOf="@id/step3_circle"
                app:layout_constraintStart_toEndOf="@id/step1_circle"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_menu_report_image"
                    app:tint="@color/white" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tv_step2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="בהכנה"
                android:textColor="#212121"
                android:textSize="10sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="@id/step2_circle"
                app:layout_constraintStart_toStartOf="@id/step2_circle"
                app:layout_constraintTop_toBottomOf="@id/step2_circle" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/step3_circle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:cardBackgroundColor="#E0E0E0"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toStartOf="@id/step4_circle"
                app:layout_constraintStart_toEndOf="@id/step2_circle"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_popup_reminder"
                    app:tint="#9E9E9E" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tv_step3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="מוכנה"
                android:textColor="#9E9E9E"
                android:textSize="10sp"
                app:layout_constraintEnd_toEndOf="@id/step3_circle"
                app:layout_constraintStart_toStartOf="@id/step3_circle"
                app:layout_constraintTop_toBottomOf="@id/step3_circle" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/step4_circle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:cardBackgroundColor="#E0E0E0"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_menu_view"
                    app:tint="#9E9E9E" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tv_step4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="נאספה"
                android:textColor="#9E9E9E"
                android:textSize="10sp"
                app:layout_constraintEnd_toEndOf="@id/step4_circle"
                app:layout_constraintStart_toStartOf="@id/step4_circle"
                app:layout_constraintTop_toBottomOf="@id/step4_circle" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Estimated Completion Box -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/estimatedCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="#E8F5E9"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="#C8E6C9"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@id/stepperLayout">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvEstimatedTimeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="זמן משוער לסיום:"
                    android:textColor="#2E7D32"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvEstimatedTimeValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#1B5E20"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    tools:text="12:45" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Order Summary -->
        <TextView
            android:id="@+id/tvSummaryLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:text="פירוט ההזמנה:"
            android:textColor="#757575"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/estimatedCard" />

        <TextView
            android:id="@+id/tvOrderSummary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="4dp"
            android:textColor="#212121"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSummaryLabel"
            tools:text="Rib meal, Fries, Coke Zero" />

        <!-- Footer Divider -->
        <View
            android:id="@+id/footerDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="#F5F5F5"
            app:layout_constraintTop_toBottomOf="@id/tvOrderSummary" />

        <!-- Footer: Total Price & Time -->
        <TextView
            android:id="@+id/tvTotalPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:textColor="#212121"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/footerDivider"
            tools:text="₪77.00" />

        <TextView
            android:id="@+id/tvOrderReceivedTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#9E9E9E"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="@id/tvTotalPrice"
            app:layout_constraintTop_toBottomOf="@id/tvTotalPrice"
            tools:text="הוזמן בשעה 12:35" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
