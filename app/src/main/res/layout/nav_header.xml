<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="180dp"
    android:background="@color/ice_blue"
    android:gravity="bottom"
    android:orientation="vertical"
    android:padding="16dp"
    android:theme="@style/ThemeOverlay.AppCompat.Dark">

    <ImageView
        android:id="@+id/ivUserPhoto"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginBottom="8dp"
        android:src="@drawable/bottom_bar_profile"
        android:contentDescription="User profile picture" />

    <TextView
        android:id="@+id/tvUserName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="שלום, אורח"
        android:textAppearance="@style/TextAppearance.AppCompat.Body1"
        android:textColor="@color/mc_text_primary"
        android:textStyle="bold"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/tvUserEmail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ברוך הבא לקפיטריה"
        android:textColor="@color/mc_text_secondary" />

</LinearLayout>
