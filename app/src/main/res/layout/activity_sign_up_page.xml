<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E8E8E8"
    android:fillViewport="true"
    android:visibility="visible">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingTop="20dp"
        android:paddingBottom="20dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/signupFormContainer"
            android:layout_width="350dp"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/white"
            app:cardCornerRadius="10dp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:id="@+id/signup_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:paddingBottom="10dp"
                    android:text="@string/signup_title"
                    android:textAlignment="center"
                    android:textColor="@color/black"
                    android:textSize="28sp"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/tv_signup_warning"
                    android:background="@drawable/bg_warning_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:gravity="right|top"
                    android:paddingBottom="10dp"
                    android:text=" שגיאה"
                    android:textColor="@color/Yellow_warning"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <EditText
                    android:id="@+id/ET_signup_name"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_input_rounded"
                    android:hint="@string/signup_name_hint"
                    android:inputType="textPersonName"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/gray" />

                <EditText
                    android:id="@+id/ET_signup_email"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_input_rounded"
                    android:hint="@string/signup_email_hint"
                    android:inputType="textEmailAddress"
                    android:padding="12dp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/gray" />

                <EditText
                    android:id="@+id/ET_signup_phoneNumber"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_input_rounded"
                    android:gravity="right"
                    android:hint="@string/signup_phone_hint"
                    android:inputType="phone"
                    android:padding="12dp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/gray" />

                <EditText
                    android:id="@+id/ET_signup_username"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_input_rounded"
                    android:hint="@string/signup_username_hint"
                    android:inputType="textPersonName"
                    android:padding="12dp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/gray" />

                <EditText
                    android:id="@+id/ET_signup_password"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_input_rounded"
                    android:hint="@string/signup_password_hint"
                    android:inputType="textPersonName"
                    android:padding="12dp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/gray" />

                <Spinner
                    android:id="@+id/Spin_signup_School"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginBottom="18dp"
                    android:background="@drawable/bg_input_rounded"
                    android:padding="12dp"
                    android:textColorHint="@color/gray" />

                <Spinner
                    android:id="@+id/Spin_signup_class"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginBottom="18dp"
                    android:background="@drawable/bg_input_rounded"
                    android:padding="12dp"
                    android:textColorHint="@color/gray" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSignup"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_button_primary"
                    android:onClick="SignUp_Click"
                    android:text="@string/signup_button"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textSize="20sp"
                    app:backgroundTint="@null"
                    app:cornerRadius="20dp" />

                <!-- כבר יש לך חשבון -->
                <LinearLayout
                    android:id="@+id/signup_login_cta_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:layoutDirection="ltr"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/signup_login_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Already have an account?"
                        android:textColor="#747474"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/signup_login_link"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:onClick="Login_Click"
                        android:text=" Log in"
                        android:textColor="#008080"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- כפתור גוגל כמו במסך התחברות -->
                <LinearLayout
                    android:id="@+id/signup_google_button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_button_google"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:onClick="SignUpGoogle_Click"
                    android:orientation="horizontal"
                    android:padding="10dp">

                    <ImageView
                        android:id="@+id/signup_google_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_google" />

                    <TextView
                        android:id="@+id/signup_google_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Sign up with Google"
                        android:textColor="#333333"
                        android:textSize="11sp" />
                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>